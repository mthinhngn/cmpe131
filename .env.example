# Leave unset for Vite's local /api proxy. Production: deployed HTTPS API base,
# including /api/v1 (the NestJS backend must allow your frontend in WEB_ORIGIN).
# VITE_API_URL=https://your-api.example.com/api/v1

# Local API proxy (defaults to the canonical backend on port 3004).
# COURSE_RADAR_API_TARGET=http://127.0.0.1:3004

# Python agent; never use a VITE_ prefix for server secrets.
# Chat uses /api/v1/agent locally so existing account cookies are forwarded.
# Vite rewrites it to /agent on Python; public schedule reads also use /agent.
# COURSE_RADAR_AGENT_TARGET=http://127.0.0.1:8000
# Production: set the public agent base URL, including its /agent prefix.
# VITE_AGENT_URL=https://your-agent.example.com/agent
GROQ_API_KEY=
TAVILY_API_KEY=
# Optional model override. No OpenAI model or embedding provider is used.
KIMI_MODEL=qwen/qwen3.8-27b
# Existing account API /auth/me endpoint; unset keeps account routes disabled.
# An authenticated same-origin proxy must forward the existing cr_session cookie.
# KIMI_AUTH_URL=http://127.0.0.1:3004/api/v1/auth/me
# AGENT_DATABASE_URL=postgresql://course_radar:course_radar@127.0.0.1:5432/course_radar
# Optional tracing; configure all three to use your own Langfuse project.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
