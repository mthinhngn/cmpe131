# Ship backend sources, but never local secrets, generated clients or test output.
api/.env*
api/generated/
api/node_modules/
api/dist/
api/test/
.references/
.agents/
.venv/
tmp/
/data/
backups/
dumps/

# Local secrets are configured in Vercel env vars, never uploaded with the source.
/.env
/.env.*
!/.env.example
