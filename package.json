{
  "name": "course-radar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "agent:dev": "python -m uvicorn agent_service.server:app --host 127.0.0.1 --port 8000",
    "agent:test": "python -m unittest discover -s agent_service/tests -v",
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "dev:all": "node scripts/dev-all.mjs",
    "test:dev": "node --test tests/dev-all.test.mjs",
    "test:routes": "node scripts/verify-page-routes.mjs",
    "build": "tsc -b && vite build --config vite.config.ts",
    "data:fall-2026": "node scripts/import-fall-2026-schedule.mjs",
    "data:sjsu": "python scripts/import_sjsu.py",
    "data:professors": "node scripts/sync-professor-profiles.mjs",
    "test:professors": "node --test tests/professor-profiles.test.mjs",
    "test:data": "python -m unittest discover -s scripts/tests -v",
    "ui:sync": "node scripts/sync-ui-reference.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "test:sync": "node tests/schedule-sync.cjs",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview --config vite.config.ts --host 0.0.0.0",
    "submission": "python scripts/package_submission.py",
    "test:submission": "python -m unittest discover -s scripts/tests -p test_submission_package.py -v"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@xyflow/react": "^12.12.0",
    "lucide-react": "^0.453.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-resizable-panels": "^4.15.0",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "~5.9.2",
    "vite": "^7.1.4"
  }
}
