{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Course Radar requirement record v1 (CP2 design)",
  "description": "One requirement, not an extraction bundle or a degree audit. Semantic promotion checks are specified in REQUIREMENT_LOOKUP_RECORD_SCHEMA.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_revision", "scope", "program", "catalog_year", "requirement_key", "title", "catalog_list_coverage", "coverage_source_refs", "verification", "sources", "aliases", "conditions", "applicability", "rule"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_revision": {"type": "integer", "minimum": 1},
    "scope": {"enum": ["program", "campus"]},
    "program": {"anyOf": [{"$ref": "#/$defs/key"}, {"type": "null"}]},
    "catalog_year": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{4}$"},
    "requirement_key": {"$ref": "#/$defs/key"},
    "title": {"$ref": "#/$defs/text"},
    "catalog_list_coverage": {"enum": ["complete", "partial", "open", "unknown"]},
    "coverage_source_refs": {"$ref": "#/$defs/refs"},
    "verification": {"$ref": "#/$defs/verification"},
    "needs_review": {"type": "boolean"},
    "review_conflicts": {"type": "array", "items": {"$ref": "#/$defs/reviewConflict"}, "uniqueItems": true},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "aliases": {"type": "array", "items": {"$ref": "#/$defs/alias"}},
    "conditions": {"type": "array", "items": {"$ref": "#/$defs/condition"}},
    "applicability": {
      "type": "object", "additionalProperties": false,
      "required": ["pattern", "condition_refs", "program_effects"],
      "properties": {
        "pattern": {"enum": ["legacy", "current", "unspecified"]},
        "condition_refs": {"$ref": "#/$defs/refs"},
        "program_effects": {"type": "array", "items": {"$ref": "#/$defs/programEffect"}}
      }
    },
    "rule": {"$ref": "#/$defs/rule"}
  },
  "allOf": [
    {"if": {"required": ["needs_review"], "properties": {"needs_review": {"const": true}}},
      "then": {"required": ["review_conflicts"], "properties": {"review_conflicts": {"minItems": 1}}},
      "else": {"properties": {"review_conflicts": {"maxItems": 0}}}},
    {"if": {"properties": {"scope": {"const": "campus"}}}, "then": {"properties": {"program": {"type": "null"}}}, "else": {"properties": {"program": {"$ref": "#/$defs/key"}}}},
    {"if": {"properties": {"verification": {"properties": {"status": {"enum": ["code_checked", "human_verified"]}}}}}, "then": {
      "properties": {
        "sources": {"minItems": 1, "items": {"properties": {
          "quote": {"$ref": "#/$defs/text"}, "url": {"$ref": "#/$defs/officialUrl"},
          "retrieved_at": {"type": "string", "format": "date-time"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "locator": {"$ref": "#/$defs/text"}
        }}}
      }
    }}
  ],
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "key": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/key"}},
    "recordId": {"type": "string", "pattern": "^(?:program:[a-z0-9-]+|campus:sjsu):[0-9]{4}-[0-9]{4}:[a-z0-9-]+$"},
    "officialUrl": {"type": "string", "format": "uri", "pattern": "^https://(?:[A-Za-z0-9-]+\\.)*sjsu\\.edu(?:/|$)"},
    "verification": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "checked_at", "checked_by"],
      "properties": {
        "status": {"enum": ["extracted", "code_checked", "human_verified"]},
        "checked_at": {"type": ["string", "null"], "format": "date-time"},
        "checked_by": {"anyOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]}
      },
      "allOf": [{"if": {"properties": {"status": {"enum": ["code_checked", "human_verified"]}}}, "then": {"properties": {
        "checked_at": {"type": "string", "format": "date-time"}, "checked_by": {"$ref": "#/$defs/text"}
      }}}]
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "quote", "url", "document_date", "retrieved_at", "sha256", "locator", "verification"],
      "properties": {
        "key": {"$ref": "#/$defs/key"},
        "quote": {"anyOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]},
        "url": {"anyOf": [{"$ref": "#/$defs/officialUrl"}, {"type": "null"}]},
        "document_date": {"type": ["string", "null"], "format": "date"},
        "retrieved_at": {"type": ["string", "null"], "format": "date-time"},
        "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "locator": {"anyOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]},
        "verification": {"$ref": "#/$defs/verification"}
      }
    },
    "alias": {
      "type": "object", "additionalProperties": false,
      "required": ["text", "kind", "candidate_ids", "source_refs"],
      "properties": {
        "text": {"$ref": "#/$defs/text"},
        "kind": {"enum": ["official", "common", "former", "ambiguous"]},
        "candidate_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/recordId"}},
        "source_refs": {"$ref": "#/$defs/refs"}
      },
      "allOf": [{"if": {"properties": {"kind": {"const": "ambiguous"}}}, "then": {"properties": {"candidate_ids": {"minItems": 2}}}, "else": {"properties": {"candidate_ids": {"maxItems": 0}}}}]
    },
    "condition": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "text", "source_refs"],
      "properties": {"key": {"$ref": "#/$defs/key"}, "text": {"$ref": "#/$defs/text"}, "source_refs": {"$ref": "#/$defs/refs"}}
    },
    "reviewConflict": {
      "type": "object", "additionalProperties": false,
      "required": ["field", "alternatives"],
      "properties": {
        "field": {"$ref": "#/$defs/text"},
        "alternatives": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["value", "source_ref"],
          "properties": {"value": {"$ref": "#/$defs/text"}, "source_ref": {"$ref": "#/$defs/key"}}
        }}
      }
    },
    "programEffect": {
      "type": "object", "additionalProperties": false,
      "required": ["program", "target_requirement_id", "effect", "text", "condition_refs", "source_refs"],
      "properties": {
        "program": {"$ref": "#/$defs/key"},
        "target_requirement_id": {"anyOf": [{"type": "string", "pattern": "^campus:sjsu:[0-9]{4}-[0-9]{4}:[a-z0-9-]+$"}, {"type": "null"}]},
        "effect": {"enum": ["covered_by_major", "waived", "modified", "unknown"]},
        "text": {"$ref": "#/$defs/text"},
        "condition_refs": {"$ref": "#/$defs/refs"}, "source_refs": {"$ref": "#/$defs/refs"}
      }
    },
    "course": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "term_id", "section_numbers", "topic", "condition_refs", "source_refs"],
      "properties": {
        "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9]{1,7} [0-9]{1,3}[A-Z]{0,3}$"},
        "term_id": {"type": ["string", "null"], "pattern": "^(fall|winter|spring|summer)-[0-9]{4}$"},
        "section_numbers": {"anyOf": [{"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9A-Z]{1,5}$"}}, {"type": "null"}]},
        "topic": {"anyOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]},
        "condition_refs": {"$ref": "#/$defs/refs"}, "source_refs": {"$ref": "#/$defs/refs"}
      }
    },
    "rule": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "kind", "text", "condition_refs", "source_refs"],
      "properties": {
        "key": {"$ref": "#/$defs/key"},
        "kind": {"enum": ["required_all", "choose_courses", "choose_units", "open_rule", "approval_required", "all_of", "any_of"]},
        "text": {"$ref": "#/$defs/text"},
        "condition_refs": {"$ref": "#/$defs/refs"}, "source_refs": {"$ref": "#/$defs/refs"},
        "includes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/course"}},
        "exclusions": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/course"}},
        "count": {"type": "integer", "minimum": 1},
        "units": {"type": "number", "exclusiveMinimum": 0},
        "children": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/rule"}}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"enum": ["all_of", "any_of"]}}}, "then": {"required": ["children"], "not": {"anyOf": [{"required": ["includes"]}, {"required": ["exclusions"]}]}}, "else": {"required": ["includes", "exclusions"], "not": {"required": ["children"]}}},
        {"if": {"properties": {"kind": {"const": "choose_courses"}}}, "then": {"required": ["count"]}, "else": {"not": {"required": ["count"]}}},
        {"if": {"properties": {"kind": {"const": "choose_units"}}}, "then": {"required": ["units"]}, "else": {"not": {"required": ["units"]}}}
      ]
    }
  }
}
