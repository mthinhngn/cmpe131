generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RuleOperator {
  AND
  OR
}

enum RequirementItemType {
  COURSE
  PLACEHOLDER
}

model Program {
  id              String           @id @default(cuid())
  slug            String           @unique
  name            String
  abbreviation    String
  catalogVersions CatalogVersion[]
}

model CatalogVersion {
  programMetadata   Json?
  id                String             @id @default(cuid())
  programId         String
  catalogYear       String
  dataVersion       String
  sourceUrl         String
  lastVerifiedAt    DateTime?
  semesterCount     Int
  program           Program            @relation(fields: [programId], references: [id], onDelete: Cascade)
  courseVersions    CourseVersion[]
  requirementGroups RequirementGroup[]
  sourceSnapshots   SourceSnapshot[]

  @@unique([programId, catalogYear])
}

model Course {
  id              String             @id
  code            String
  versions        CourseVersion[]
  requiredByRules PrerequisiteRule[] @relation("RequiredCourse")
  sections        Section[]
  universityRecords UniversityCourseRecord[]
  importedSections UniversitySectionRecord[]

  @@unique([code, id])
}

// University course facts are independent of the two degree requirement sets.
// Null catalog fields mean the official description has not been retrieved.
model UniversityCourseRecord {
  courseId          String
  catalogYear       String
  title             String
  units             Float?
  unitsText         String
  description       String?
  prerequisiteText  String?
  corequisiteText   String?
  prerequisiteCodes String[] @default([])
  corequisiteCodes  String[] @default([])
  sourceUrl         String
  catalogStatus     String
  fetchedAt         DateTime
  course            Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([courseId, catalogYear])
}

model Term {
  id        String    @id
  name      String
  sourceUrl String
  fetchedAt DateTime
  sections  Section[]
  importedSections UniversitySectionRecord[]
}

// Lossless source rows include iSchool fields absent from the legacy Section model.
model UniversitySectionRecord {
  termId      String
  classNumber String
  courseId    String
  sourceUrl   String
  evidence    Json
  fetchedAt   DateTime
  course      Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  term        Term @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@id([termId, classNumber])
  @@index([courseId, termId])
}

model Section {
  id            String @id @default(cuid())
  termId        String
  courseId      String
  classNumber   String
  sectionNumber String
  mode          String
  component     String
  days          String
  times         String
  location      String
  dates         String
  openSeats     Int
  instructors   String[] @default([])
  term          Term   @relation(fields: [termId], references: [id], onDelete: Cascade)
  course        Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([termId, classNumber])
  @@index([courseId, termId])
}

model CourseVersion {
  id                  String               @id @default(cuid())
  courseId            String
  catalogVersionId    String
  title               String
  description         String
  prerequisiteText    String?
  units               Float
  course              Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  catalogVersion      CatalogVersion       @relation(fields: [catalogVersionId], references: [id], onDelete: Cascade)
  prerequisiteRules   PrerequisiteRule[]
  programRequirements ProgramRequirement[]

  @@unique([courseId, catalogVersionId])
}

model PrerequisiteRule {
  id                   String        @id @default(cuid())
  courseVersionId      String
  requiredCourseId     String
  groupKey             String        @default("default")
  operator             RuleOperator  @default(AND)
  minimumGrade         String?
  isCorequisite        Boolean       @default(false)
  requiresManualReview Boolean       @default(false)
  courseVersion        CourseVersion @relation(fields: [courseVersionId], references: [id], onDelete: Cascade)
  requiredCourse       Course        @relation("RequiredCourse", fields: [requiredCourseId], references: [id])
}

model RequirementGroup {
  id               String               @id @default(cuid())
  key              String
  catalogVersionId String
  title            String
  description      String
  sortOrder        Int
  catalogVersion   CatalogVersion       @relation(fields: [catalogVersionId], references: [id], onDelete: Cascade)
  requirements     ProgramRequirement[]

  @@unique([catalogVersionId, sortOrder])
  @@unique([catalogVersionId, key])
}

model ProgramRequirement {
  id                  String              @id @default(cuid())
  sourceKey           String
  requirementGroupId  String
  itemType            RequirementItemType
  courseVersionId     String?
  label               String?
  description         String?
  recommendedSemester Int?
  sortOrder           Int
  requirementGroup    RequirementGroup    @relation(fields: [requirementGroupId], references: [id], onDelete: Cascade)
  courseVersion       CourseVersion?      @relation(fields: [courseVersionId], references: [id], onDelete: Cascade)

  @@unique([requirementGroupId, sortOrder])
  @@unique([requirementGroupId, sourceKey])
}

model SourceSnapshot {
  id               String         @id @default(cuid())
  catalogVersionId String
  sourceUrl        String
  fetchedAt        DateTime
  status           String
  checksum         String?
  catalogVersion   CatalogVersion @relation(fields: [catalogVersionId], references: [id], onDelete: Cascade)
}

model PersonalWorkspace {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  version   Int      @default(0)
  state     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  operations PersonalOperation[]
}

// Public verified term evidence. Personal semester numbers derive from profiles.
model SharedAcademicCalendar {
  id        String   @id
  evidence  Json
  updatedAt DateTime @default(now()) @updatedAt
}

// Append-only receipts and before-images make retries and Undo survive restarts.
model PersonalOperation {
  workspaceId String
  requestId   String
  fingerprint String
  kind        String
  before      Json
  result      Json
  createdAt   DateTime @default(now())
  workspace   PersonalWorkspace @relation(fields: [workspaceId], references: [id])

  @@id([workspaceId, requestId])
  @@index([workspaceId, createdAt])
}
