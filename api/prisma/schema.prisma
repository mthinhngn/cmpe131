generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RuleOperator {
  AND
  OR
}

enum RequirementItemType {
  COURSE
  PLACEHOLDER
}

model Program {
  id              String           @id @default(cuid())
  slug            String           @unique
  name            String
  abbreviation    String
  catalogVersions CatalogVersion[]
}

model CatalogVersion {
  id                String             @id @default(cuid())
  programId         String
  catalogYear       String
  dataVersion       String
  sourceUrl         String
  lastVerifiedAt    DateTime?
  semesterCount     Int
  program           Program            @relation(fields: [programId], references: [id], onDelete: Cascade)
  courseVersions    CourseVersion[]
  requirementGroups RequirementGroup[]
  sourceSnapshots   SourceSnapshot[]

  @@unique([programId, catalogYear])
}

model Course {
  id              String             @id
  code            String
  versions        CourseVersion[]
  requiredByRules PrerequisiteRule[] @relation("RequiredCourse")

  @@unique([code, id])
}

model CourseVersion {
  id                  String               @id @default(cuid())
  courseId            String
  catalogVersionId    String
  title               String
  description         String
  units               Int
  course              Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  catalogVersion      CatalogVersion       @relation(fields: [catalogVersionId], references: [id], onDelete: Cascade)
  prerequisiteRules   PrerequisiteRule[]
  programRequirements ProgramRequirement[]

  @@unique([courseId, catalogVersionId])
}

model PrerequisiteRule {
  id                   String        @id @default(cuid())
  courseVersionId      String
  requiredCourseId     String
  groupKey             String        @default("default")
  operator             RuleOperator  @default(AND)
  minimumGrade         String?
  isCorequisite        Boolean       @default(false)
  requiresManualReview Boolean       @default(false)
  courseVersion        CourseVersion @relation(fields: [courseVersionId], references: [id], onDelete: Cascade)
  requiredCourse       Course        @relation("RequiredCourse", fields: [requiredCourseId], references: [id])
}

model RequirementGroup {
  id               String               @id @default(cuid())
  key              String
  catalogVersionId String
  title            String
  description      String
  sortOrder        Int
  catalogVersion   CatalogVersion       @relation(fields: [catalogVersionId], references: [id], onDelete: Cascade)
  requirements     ProgramRequirement[]

  @@unique([catalogVersionId, sortOrder])
  @@unique([catalogVersionId, key])
}

model ProgramRequirement {
  id                  String              @id @default(cuid())
  sourceKey           String
  requirementGroupId  String
  itemType            RequirementItemType
  courseVersionId     String?
  label               String?
  description         String?
  recommendedSemester Int?
  sortOrder           Int
  requirementGroup    RequirementGroup    @relation(fields: [requirementGroupId], references: [id], onDelete: Cascade)
  courseVersion       CourseVersion?      @relation(fields: [courseVersionId], references: [id], onDelete: Cascade)

  @@unique([requirementGroupId, sortOrder])
  @@unique([requirementGroupId, sourceKey])
}

model SourceSnapshot {
  id               String         @id @default(cuid())
  catalogVersionId String
  sourceUrl        String
  fetchedAt        DateTime
  status           String
  checksum         String?
  catalogVersion   CatalogVersion @relation(fields: [catalogVersionId], references: [id], onDelete: Cascade)
}
