{
  "name": "course-radar-api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/*.test.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "users:generate": "prisma generate --schema users/schema.prisma",
    "users:migrate": "prisma migrate deploy --schema users/schema.prisma",
    "predev": "npm run clients:generate",
    "prebuild": "npm run clients:generate",
    "pretest": "npm run clients:generate",
    "pretypecheck": "npm run clients:generate",
    "clients:generate": "node scripts/generate-clients.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@prisma/client": "6.19.0",
    "dotenv": "^17.4.2",
    "google-auth-library": "^11.3.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.6",
    "@types/express": "^5.0.6",
    "@types/node": "^24.3.1",
    "prisma": "6.19.0",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "effect": "3.22.2",
    "multer": "2.3.0"
  }
}
