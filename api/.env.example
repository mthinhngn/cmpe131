DATABASE_URL="postgresql://YOUR_DATABASE_USER:YOUR_DATABASE_PASSWORD@localhost:5432/course_radar?schema=public"
PORT=3004
WEB_ORIGIN="http://localhost:5175"

USER_DATABASE_URL="postgresql://YOUR_DATABASE_USER:YOUR_DATABASE_PASSWORD@localhost:5433/course_radar_users?schema=public"
AUTH_DELIVERY=log
AUTH_WEB_ORIGIN="http://localhost:5175"

# Real email to your own inbox, with links back to localhost:
# Set AUTH_DELIVERY=resend, then fill these in your ignored api/.env.
# AUTH_TEST_EMAIL must match the email used to create your Resend account.
RESEND_API_KEY=
AUTH_TEST_EMAIL=

# Production: AUTH_DELIVERY=resend, AUTH_WEB_ORIGIN=https://cmpe131.vercel.app,
# WEB_ORIGIN=https://cmpe131.vercel.app, and two hosted PostgreSQL URLs.
# Keep AUTH_TEST_EMAIL to restrict sign-in to the Resend test inbox.
# For public sign-in, verify a Resend domain, set a sender below and remove AUTH_TEST_EMAIL.
AUTH_EMAIL_FROM=
